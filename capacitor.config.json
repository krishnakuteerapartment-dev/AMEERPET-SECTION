{
  "appId": "com.ameerpetsection.yrgdtr",
  "appName": "DTR Verify",
  "webDir": "www",
  "backgroundColor": "#eef2f0",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 4000,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0f5a4e",
      "showSpinner": false
    }
  }
}
